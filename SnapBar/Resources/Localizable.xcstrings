    },
    "macOS Screenshots": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "צילומי macOS"
          }
        }
      }
    },
    "macOS already uses %@.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS כבר משתמשת ב-%@."
          }
        }
      }
    },
    "macOS asks every app that takes screenshots for this permission. Without it, screenshots come out empty.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS מבקשת את ההרשאה הזו מכל אפליקציה שמצלמת מסך. בלעדיה הצילומים יוצאים ריקים."
          }
        }
      }
    },
