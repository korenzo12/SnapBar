    "Yesterday": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אתמול"
          }
        }
      }
    },
    "You can restore them from the Trash.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר לשחזר אותם מהפח."
          }
        }
      }
    },
    "Your marks will be lost. Copy or save first to keep them.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הסימונים יאבדו. כדי לשמור אותם, קודם מעתיקים או שומרים."
          }
        }
      }
    },
    "Zoom In": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגדל"
          }
        }
      }
