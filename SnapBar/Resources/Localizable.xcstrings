    "⇧⌘4 keeps working. SnapBar can catch those screenshots too.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "⇧⌘4 ממשיך לעבוד. SnapBar יכולה לתפוס גם את הצילומים האלה."
