      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קבצים"
          }
        }
      }
    },
    "Filter by date, by app, or by words that appear inside the picture.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סינון לפי תאריך, לפי אפליקציה או לפי מילים שמופיעות בתוך התמונה."
          }
        }
      }
    },
    "From": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מתאריך"
          }
        }
      }
    },
    "General": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כללי"
          }
        }
      }
    },
    "Halves the pixel size so files are smaller. Leave it off for full sharpness.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מקטין את התמונה לחצי כדי שהקבצים יהיו קטנים יותר. כשזה כבוי, החדות מלאה."
          }
        }
      }
    },
    "Help": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עזרה"
          }
        }
      }
    },
