            "value": "כשהחלונית כבויה"
          }
        }
      }
    },
    "Where screenshots are saved": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "איפה הצילומים נשמרים"
          }
        }
      }
    },
