{
  "sourceLanguage": "en",
  "strings": {
    "%lld screenshots": {
      "localizations": {
        "he": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "צילום מסך אחד"
                }
              },
              "two": {
                "stringUnit": {
                  "state": "translated",
                  "value": "שני צילומי מסך"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld צילומי מסך"
                }
              }
            }
          }
        }
      }
    },
    "%lld screenshots found on the Desktop.": {
      "localizations": {
        "he": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "נמצא צילום מסך אחד בשולחן העבודה."
                }
              },
              "two": {
                "stringUnit": {
                  "state": "translated",
                  "value": "נמצאו שני צילומי מסך בשולחן העבודה."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "נמצאו %lld צילומי מסך בשולחן העבודה."
                }
              }
            }
          }
        }
      }
    },
    "A panel that waits for you": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חלונית שמחכה לך"
