      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ייצוא…"
          }
        }
      }
    },
    "Favorite": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מועדף"
