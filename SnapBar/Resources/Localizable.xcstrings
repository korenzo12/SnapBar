    "Click a shortcut, then press the new keys. Esc cancels and Delete clears it. ⇧⌘4 keeps working as usual.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לוחצים על קיצור ואז על המקשים החדשים. Esc מבטל ו-Delete מנקה. ⇧⌘4 ממשיך לעבוד כרגיל."
          }
        }
      }
    },
    "Close": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סגור"
          }
        }
      }
