      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מועדפים נשמרים תמיד."
          }
        }
      }
    },
    "File": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קובץ"
          }
        }
      }
    },
